<Project>
  <!-- Automatically deploys TixlWebHost alongside TiXL build outputs so manual install.ps1 runs aren't required during development -->
  <Target Name="DeployTixlWebHost" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)WebHost\TixlWebHost.csproj') and '$(MSBuildProjectName)' != 'TixlWebHost'">
    <Message Text="Deploying TixlWebHost ($(Configuration)) to %LOCALAPPDATA%\TiXL\WebHost..." Importance="high" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)WebHost\TixlWebHost.csproj&quot; -c $(Configuration) -o &quot;$(LocalAppData)\TiXL\WebHost&quot; --nologo" />
  </Target>
</Project>
